---
import '../../styles/global.css';
import '../../styles/app.css';
import {bookSnapshot} from '../../lib/bookSnapshot';
import KioskLending from '../../components/library/KioskLending.svelte';
const books=bookSnapshot();
const selected=books.find(book=>book.id===4)||books[0];
const shortTitle=(value:string)=>value.split(/:\s+|\s+(?=Proven Strategies For\b)/i)[0];
---
<!doctype html>
<html lang="en" class="theme-light">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Your library — Kiosk workspace</title></head>
<body class="kiosk">
<a href="#collection" class="skip-link">Skip to books</a>
<header class="topbar">
<a class="home-title" href="/" aria-label="Library home">Your library<span class="brand-dot" aria-hidden="true">.</span></a>
<form class="scan-form" role="search">
<div class="scan-label"><label for="split-search">Scan ISBN or search your books</label><span id="scan-state" aria-live="polite">Ready to scan</span></div>
<div class="scan-control"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8V3h5m8 0h5v5m0 8v5h-5m-8 0H3v-5M7 7v10m3-10v10m4-10v10m3-10v10"/></svg><input id="split-search" type="search" autocomplete="off" placeholder="ISBN, title or author" autofocus aria-label="Scan ISBN or search title or author"/><button type="submit">Search</button></div>
</form>
<a class="returns-link" href="/loans/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5 3 11l6 6M4 11h11a6 6 0 0 1 6 6v2"/></svg><span>Returns</span></a>
</header>
<main class="kiosk-workspace">
<section id="collection" class="collection" aria-label="Books in your library" tabindex="-1">
<div class="collection-heading"><h1>Your books <span id="book-count">{books.length}</span></h1><a href="/scan/">Add a book <span aria-hidden="true">+</span></a></div>
<div class="book-grid">
{books.map(book=><button class:list={['book-choice',{'is-selected':book.id===selected?.id}]} type="button" data-select-book={book.id} data-isbn={book.isbn} data-search={`${book.title} ${book.authors.join(' ')}`.toLowerCase()} aria-pressed={book.id===selected?.id} aria-label={`Select ${book.title}`} aria-controls="selected-book">
<div class="cover-space">{book.cover_url?<img src={book.cover_url} alt=""/>:<div class="missing-cover" aria-label="No cover image"><span>{shortTitle(book.title)}</span><small>{book.authors[0]}</small></div>}</div>
<span class="caption"><span class="book-title">{shortTitle(book.title)}</span><span class="book-author">{book.authors.length>1?`${book.authors[0]} & others`:book.authors[0]||'Author not recorded'}</span></span>
</button>)}
</div><p id="no-results" hidden>No books match. Try another title or author.</p>
</section>
<aside id="selected-book" class="detail-pane" aria-label="Selected book">
<div class="pane-heading"><span>Selected book</span><button class="back-to-books" type="button">Back to books ↑</button></div>
{books.map(book=><header class="book-identity" data-book-detail={book.id} hidden={book.id!==selected?.id}>{book.cover_url?<img class="identity-cover" src={book.cover_url} alt={`Cover of ${book.title}`}/>:<div class="identity-missing" aria-label="No cover image">{shortTitle(book.title)}</div>}<div><h2>{shortTitle(book.title)}</h2><p>{book.authors.join(', ')||'Author not recorded'}</p></div></header>)}
{selected&&<KioskLending initialBookId={selected.id} client:load/>}
{books.map(book=><div class="book-details" data-book-metadata={book.id} hidden={book.id!==selected?.id}>
<details><summary>Book information <span aria-hidden="true">+</span></summary><dl><div><dt>Publisher</dt><dd>{book.publisher||'Not recorded'}</dd></div><div><dt>Published</dt><dd>{book.publication_date||'Not recorded'}</dd></div><div><dt>ISBN</dt><dd>{book.isbn||'No ISBN'}</dd></div></dl></details>
<a class="details-link" href={`/books/${book.id}/`}>Full details &amp; editing <span aria-hidden="true">↗</span></a>
</div>)}
{!books.length&&<p>Scan your first book to begin.</p>}
<a class="tools-link" href="/">All library tools <span aria-hidden="true">↗</span></a>
</aside>
</main><span id="selection-status" class="sr-only" aria-live="polite"></span>
<noscript><p>Enable JavaScript to scan, select and lend books. <a href="/">Open the library</a>.</p></noscript>
</body></html>
<style>
:global(.kiosk){--kiosk-ink:var(--app-ink);--kiosk-green:var(--app-accent);--kiosk-muted:var(--app-muted);--kiosk-line:var(--app-line);--kiosk-paper:var(--app-paper);margin:0;background:var(--app-paper);color:var(--app-ink);font:400 16px/1.5 'Library Inter',system-ui,sans-serif;min-height:100svh}
:global(.kiosk *){box-sizing:border-box}:global(.kiosk [hidden]){display:none!important}:global(.kiosk h1),:global(.kiosk h2),:global(.kiosk p){margin:0}:global(.kiosk :is(h1,h2,h3,p)::before),:global(.kiosk :is(h1,h2,h3,p)::after){content:none;display:none}:global(.kiosk button),:global(.kiosk input){font:inherit}:global(.kiosk button),:global(.kiosk a){touch-action:manipulation;-webkit-tap-highlight-color:transparent}:global(.kiosk button:focus-visible),:global(.kiosk a:focus-visible),:global(.kiosk summary:focus-visible){outline:2px solid var(--app-accent);outline-offset:4px}:global(.kiosk a){color:inherit;text-decoration:none}
.topbar{display:grid;grid-template-columns:220px minmax(240px,620px) 1fr;align-items:center;gap:32px;padding:8px 32px 10px;background:var(--app-surface);border-bottom:1px solid var(--app-line)}
.home-title{font:400 34px/1 Newsreader,Georgia,serif;letter-spacing:-.035em;white-space:nowrap}.brand-dot{color:var(--app-accent)}.scan-label{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;gap:12px}.scan-label label{font-size:15px;font-weight:600;line-height:1.3}.scan-label>span{font-size:13px;color:var(--app-accent);display:flex;align-items:center;gap:6px}.scan-label>span::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}.scan-label>span.inactive{color:var(--app-muted)}.scan-label>span.inactive::before{background:transparent;border:1px solid currentColor}.scan-control{display:flex;align-items:center;gap:14px;height:52px;border:1px solid #aeb9a9;border-radius:4px;padding:0 7px 0 16px;background:var(--app-surface)}.scan-control:focus-within{border-color:var(--app-accent);box-shadow:0 0 0 1px var(--app-accent)}.scan-control>svg{width:24px;height:24px;stroke:var(--app-accent);stroke-width:1.5;fill:none;flex-shrink:0}.scan-control input{width:100%;min-width:0;flex:1;outline:0;border:0;background:none;font-size:17px;height:48px;padding:0;color:var(--app-ink)}.scan-control input::placeholder{color:#626b60}.scan-control button{display:flex;align-items:center;gap:12px;background:#edf1e9;color:var(--app-accent);border:0;border-radius:2px;min-height:40px;padding:0 15px;font-size:14px;font-weight:600;cursor:pointer}.scan-control button:hover{background:#e0e8d9}.returns-link{justify-self:end;display:flex;align-items:center;justify-content:center;gap:10px;min-height:52px;font-size:16px;padding:0 15px;border-radius:4px;border:1px solid var(--app-line)}.returns-link:hover{background:var(--app-paper)}.returns-link svg{width:22px;height:22px;stroke:var(--app-accent);stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round}
.kiosk-workspace{display:grid;grid-template-columns:minmax(0,1fr) 330px;min-height:calc(100svh - 96px)}.collection{min-width:0;padding:18px 28px 20px}.collection-heading{display:flex;align-items:center;justify-content:space-between;margin:0 4px 12px}.collection-heading h1{font:400 18px/1.4 'Library Inter',system-ui,sans-serif;letter-spacing:0;display:flex;align-items:center;gap:12px}.collection-heading h1 span{font-size:14px;color:var(--app-muted);font-variant-numeric:tabular-nums}.collection-heading>a{font-size:14px;display:flex;align-items:center;gap:12px;min-height:44px;color:var(--app-muted)}.collection-heading>a:hover{color:var(--app-accent)}.collection-heading>a span{font-size:22px}.book-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px 24px}.book-choice{display:flex;flex-direction:column;align-items:center;min-width:0;padding:6px 8px 0;border:0;border-radius:3px;text-align:left;background:transparent;color:inherit;cursor:pointer}.cover-space{height:225px;display:flex;align-items:end;justify-content:center;width:100%;margin-bottom:12px}.cover-space img{width:auto;max-width:100%;height:100%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 5px 5px #20262020)}.missing-cover{height:100%;width:150px;max-width:100%;background:#e9e4d7;border:1px solid #d8d2c1;padding:24px 18px;display:flex;flex-direction:column;justify-content:space-between;font:400 27px/1.1 Newsreader,Georgia,serif;overflow-wrap:anywhere;box-shadow:0 5px 5px #20262012}.missing-cover small{font:400 12px/1.4 'Library Inter',system-ui,sans-serif;color:#53604f}.caption{display:flex;flex-direction:column;align-self:center;width:100%;max-width:240px;padding:0 0 9px;text-align:center;border-bottom:2px solid transparent;gap:4px}.book-title{font-size:16px;line-height:1.35;font-weight:600}.book-author{font-size:14px;line-height:1.4;color:var(--app-muted)}.book-choice.is-selected .caption{color:var(--app-accent)}.book-choice.is-selected .book-title::before{content:"✓";margin-right:7px;font-size:14px}.book-choice.is-selected .cover-space img,.book-choice.is-selected .missing-cover{outline:2px solid var(--app-accent);outline-offset:5px}.book-choice:hover .caption{color:var(--app-accent)}
.detail-pane{display:flex;flex-direction:column;min-width:0;padding:28px 27px 24px;background:#fafbf7;border-left:1px solid var(--app-line)}.pane-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;color:var(--app-muted);font-size:13px}.back-to-books{display:none}.book-identity{display:grid;grid-template-columns:64px minmax(0,1fr);gap:16px;align-items:start;margin-bottom:28px}.identity-cover{display:block;width:64px;height:97px;object-fit:contain;object-position:left top;filter:drop-shadow(0 3px 3px #20262015)}.identity-missing{width:64px;height:97px;background:#e9e4d7;padding:10px 7px;font:400 17px/1.1 Newsreader,Georgia,serif;overflow-wrap:anywhere}.book-identity>div{min-width:0}.book-identity h2{font:400 34px/1.05 Newsreader,Georgia,serif;letter-spacing:-.025em;overflow-wrap:anywhere}.book-identity p{font-size:14px;color:var(--app-muted);line-height:1.5;margin-top:9px;overflow-wrap:anywhere}.book-details{margin-top:26px;border-top:1px solid var(--app-line)}.book-details summary{display:flex;align-items:center;justify-content:space-between;gap:20px;list-style:none;min-height:50px;font-size:14px;cursor:pointer}.book-details summary::-webkit-details-marker{display:none}.book-details summary span{font-size:22px;font-weight:400}.book-details details[open] summary span{transform:rotate(45deg)}.book-details dl{display:grid;gap:14px;margin:0;padding:7px 0 20px}.book-details dl div{display:grid;grid-template-columns:74px minmax(0,1fr);gap:10px;font-size:13px;line-height:1.5}.book-details dt{color:var(--app-muted)}.book-details dd{margin:0;overflow-wrap:anywhere}.details-link{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:14px;min-height:48px}.details-link:hover,.tools-link:hover{text-decoration:underline;text-underline-offset:4px}.tools-link{margin-top:auto;padding-top:32px;min-height:48px;font-size:13px;color:var(--app-muted)!important;display:flex;align-items:center;gap:12px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.skip-link{position:fixed;top:-100px;left:16px;padding:12px;background:var(--app-surface);z-index:20}.skip-link:focus{top:16px}
@media(min-width:1500px){.kiosk-workspace{grid-template-columns:minmax(0,1fr) 370px}.book-grid{gap:28px 45px}.cover-space{height:280px}.missing-cover{width:186px}.collection{padding-inline:48px}.detail-pane{padding-inline:32px}}
@media(max-width:1120px){.topbar{grid-template-columns:180px minmax(240px,1fr) auto;gap:24px;padding-inline:28px}.home-title{font-size:30px}.kiosk-workspace{grid-template-columns:minmax(0,1fr) 310px}.book-grid{gap:24px 18px;grid-template-columns:repeat(2,minmax(0,1fr))}.collection{padding-inline:24px}.detail-pane{padding-inline:24px}.cover-space{height:225px}}
@media(max-width:760px){.topbar{grid-template-columns:minmax(0,1fr) auto;gap:20px 16px;padding:20px}.home-title{font-size:30px}.returns-link{grid-column:2;grid-row:1;min-height:44px;padding-inline:12px;font-size:14px}.scan-form{grid-column:1/-1;grid-row:2}.scan-label label{font-size:13px}.scan-label>span{font-size:11px}.scan-control{gap:10px;padding-left:12px}.scan-control input{font-size:16px}.scan-control button{gap:8px;padding-inline:12px}.kiosk-workspace{display:flex;flex-direction:column}.collection{padding:16px 12px 22px}.collection-heading{margin-inline:8px;margin-bottom:14px}.book-grid{display:flex;overflow-x:auto;scroll-snap-type:x proximity;padding:7px 8px 10px;gap:16px}.book-choice{width:156px;flex-shrink:0;scroll-snap-align:start;padding:0 5px 6px}.cover-space{height:190px;margin-bottom:14px}.caption{max-width:none}.book-title{font-size:15px}.book-author{font-size:12px}.missing-cover{font-size:24px;padding:20px 14px}.detail-pane{border-left:0;border-top:1px solid var(--app-line);padding:25px 24px}.book-identity h2{font-size:38px}.book-identity{margin-bottom:25px}.back-to-books{display:block;min-height:44px;border:0;background:none;color:var(--app-accent);font-size:13px;padding:0}.pane-heading{margin-bottom:12px}.tools-link{padding-top:20px}.book-details{margin-top:20px}}
@media(prefers-reduced-motion:reduce){:global(.kiosk *){scroll-behavior:auto!important}}
</style>
<script>
const choices=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-select-book]'));
const panels=Array.from(document.querySelectorAll<HTMLElement>('[data-book-detail]'));
const metadata=Array.from(document.querySelectorAll<HTMLElement>('[data-book-metadata]'));
const input=document.querySelector<HTMLInputElement>('#split-search');
const status=document.querySelector<HTMLElement>('#selection-status');
const scanner=document.querySelector<HTMLElement>('#scan-state');
const canLeave=()=>window.dispatchEvent(new CustomEvent('library-kiosk-navigation',{cancelable:true}));
const canonical=(raw:string)=>{const isbn=raw.replace(/[\s-]/g,'').toUpperCase();if(isbn.length!==10)return isbn;const body=`978${isbn.slice(0,9)}`;return body+(10-[...body].reduce((sum,n,i)=>sum+Number(n)*(i%2?3:1),0)%10)%10;};
function selectBook(id:string,reveal=false){const accepted=window.dispatchEvent(new CustomEvent('library-kiosk-select',{detail:{bookId:Number(id)},cancelable:true}));if(!accepted)return;choices.forEach(c=>{const active=c.dataset.selectBook===id;c.classList.toggle('is-selected',active);c.setAttribute('aria-pressed',String(active));});panels.forEach(p=>p.hidden=p.dataset.bookDetail!==id);metadata.forEach(p=>p.hidden=p.dataset.bookMetadata!==id);const panel=panels.find(p=>p.dataset.bookDetail===id);if(status)status.textContent=`Selected ${panel?.querySelector('h2')?.textContent||'book'}`;if(reveal&&matchMedia('(max-width:760px)').matches)document.querySelector('#selected-book')?.scrollIntoView({block:'start'});}
function filter(){const q=(input?.value||'').trim().toLowerCase();let count=0;choices.forEach(c=>{c.hidden=!!q&&!c.dataset.search?.includes(q);if(!c.hidden)count++;});document.querySelector('#book-count')!.textContent=String(count);(document.querySelector('#no-results') as HTMLElement).hidden=count>0;}
choices.forEach(c=>c.addEventListener('click',()=>selectBook(c.dataset.selectBook||'',true)));
input?.addEventListener('input',()=>{if(!/^[\d\s-]+[Xx]?$/.test(input.value))filter();});
input?.addEventListener('focus',()=>{if(scanner){scanner.textContent='Ready to scan';scanner.classList.remove('inactive');}});
input?.addEventListener('blur',()=>{if(scanner){scanner.textContent='Tap to scan';scanner.classList.add('inactive');}});
document.querySelector('.scan-form')?.addEventListener('submit',event=>{event.preventDefault();const code=(input?.value||'').trim().replace(/[\s-]/g,'').toUpperCase();if(!/^(?:\d{9}[\dX]|\d{13})$/.test(code)){filter();return;}const match=choices.find(c=>canonical(c.dataset.isbn||'')===canonical(code));if(match){if(input)input.value='';filter();selectBook(match.dataset.selectBook||'',true);input?.focus({preventScroll:true});}else if(canLeave())location.assign(`/scan/?isbn=${encodeURIComponent(code)}`);});
document.addEventListener('click',event=>{const link=event.target instanceof Element?event.target.closest<HTMLAnchorElement>('a[href]'):null;if(link&&!link.getAttribute('href')?.startsWith('#')&&!canLeave())event.preventDefault();});
document.querySelector('.back-to-books')?.addEventListener('click',()=>{document.querySelector('.topbar')?.scrollIntoView({block:'start'});input?.focus({preventScroll:true});});
window.addEventListener('library-kiosk-ready',()=>{const id=panels.find(p=>!p.hidden)?.dataset.bookDetail;if(id)window.dispatchEvent(new CustomEvent('library-kiosk-select',{detail:{bookId:Number(id)},cancelable:true}));});
</script>
