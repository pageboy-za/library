---
import {bookSnapshot} from '../../lib/bookSnapshot';
import inter from '../../assets/fonts/inter-regular.woff2';
import newsreader from '../../assets/fonts/newsreader-latin.woff2';

const books = bookSnapshot();
const featured = books.find(book => book.id === 4) ?? books[0];
const bookIndex = books.map(({id, isbn}) => ({id, isbn}));
const tones = ['#d8b986', '#e99370', '#b9c7c9', '#bdc8ad', '#d4d1b2'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2eb" />
    <title>The library desk · Design preview</title>
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreader} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`@font-face{font-family:'Desk Inter';src:url('${inter}') format('woff2');font-weight:100 900;font-display:swap}@font-face{font-family:'Desk Newsreader';src:url('${newsreader}') format('woff2');font-weight:200 800;font-display:swap}`}></style>
  </head>
  <body>
    <a class="skip" href="#desk">Skip to the desk</a>
    <header class="app-header">
      <a class="wordmark" href="/" aria-label="Library home">
        <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M4 5h5v18H4zm8 0h5v18h-5zm7 1 4-1 4 17-4 1z" /></svg>
        <span>Library<span class="wordmark-dot">.</span></span>
      </a>
      <nav aria-label="Library navigation">
        <a class="current" href="#desk" aria-current="page">The desk</a>
        <a href="/">Browse</a>
        <a href="/loans/">Loans <span aria-hidden="true">↗</span></a>
      </nav>
      <a class="preview" href="/"><span>Design preview</span><span aria-hidden="true">↗</span></a>
    </header>

    <main id="desk">
      <div class="desk-layout">
        <section class="scan-station" aria-labelledby="scan-title">
          <div class="station-heading"><span class="eyebrow">Your library desk</span><span class="station-mark" aria-hidden="true">01 / SCAN</span></div>
          <div class="scan-intro">
            <h1 id="scan-title">Book in hand?</h1>
            <p id="scan-description">Scan its barcode to get started.</p>
          </div>

          <form id="isbn-form" class="scan-form" action="/scan/" method="get" data-books={JSON.stringify(bookIndex)}>
            <div class="scan-symbol" aria-hidden="true">
              <svg viewBox="0 0 160 90"><path class="corners" d="M20 27V12h18M122 12h18v15M20 63v15h18M122 78h18V63" /><path class="bars" d="M40 29v31m7-31v31m6-31v31m9-31v31m5-31v31m9-31v31m5-31v31m5-31v31m9-31v31m7-31v31m5-31v31m9-31v31m5-31v31" /><path class="scan-line" d="M9 45h142" /></svg>
            </div>
            <label for="desk-isbn">Book barcode / ISBN</label>
            <div class="input-row"><input id="desk-isbn" name="isbn" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" placeholder="Scan or enter ISBN" required aria-describedby="isbn-help" /><button type="submit" aria-label="Find this book"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></button></div>
            <p id="isbn-help">Press Enter to open the book.</p>
          </form>

          <div class="desk-actions" aria-label="Lending actions">
            <button id="lend-book" class="desk-action" type="button">
              <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M5 7h10v15H5zM9 4h10v9m-1 5h8m-3-3 3 3-3 3" /></svg>
              <span><strong>Lend a book</strong><small>Start with a scan</small></span><span class="action-arrow" aria-hidden="true">↗</span>
            </button>
            <a class="desk-action" href="/loans/">
              <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M13 7h10v15H13zM9 4h10M2 16h8m-5-3-3 3 3 3" /></svg>
              <span><strong>Return a book</strong><small>Find the loan</small></span><span class="action-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="desk-note" id="desk-note" aria-live="polite">A familiar book opens straight to its page.</p>
        </section>

        <section class="book-stage" aria-labelledby="stage-title">
          <div class="stage-heading"><h2 id="stage-title" class="eyebrow">From your library</h2><span class="stage-number" aria-hidden="true">A book worth opening</span></div>
          {featured ? (
            <>
              <div class="book-scene">
                <div class="scene-line" aria-hidden="true"></div>
                <a class="hero-cover" id="hero-cover-link" href={`/books/${featured.id}/`} aria-label={`Open ${featured.title}`}>
                  <div class="cover-fallback" id="hero-fallback" style={`--cover-tone: ${tones[books.indexOf(featured) % tones.length]}`}>
                    <span class="fallback-library">THE HOME LIBRARY</span><strong id="fallback-title">{featured.title}</strong><span class="fallback-rule"></span><span id="fallback-author">{featured.authors.join(', ')}</span>
                  </div>
                  <img id="hero-image" src={featured.cover_url || undefined} alt="" width="220" height="330" hidden={!featured.cover_url} />
                  <span class="book-spine" aria-hidden="true"></span>
                </a>
                <div class="book-caption" aria-live="polite">
                  <p class="caption-label">In your collection</p>
                  <h3 id="hero-title">{featured.title}</h3>
                  <p id="hero-author">{featured.authors.join(', ')}</p>
                  <a id="hero-open" class="open-book" href={`/books/${featured.id}/`}>Open book <span aria-hidden="true">↗</span></a>
                </div>
              </div>
              <div class="stage-footer"><span>Good books, close at hand.</span><svg viewBox="0 0 25 25" fill="none" aria-hidden="true"><path d="M3 5c4-1 6 0 9 2 3-2 6-3 10-2v15c-4-1-6 0-10 2-3-2-5-3-9-2zM12 7v15" /></svg></div>
            </>
          ) : <div class="empty-stage"><p>Your books will appear here.</p><a href="/scan/">Find your first book <span aria-hidden="true">↗</span></a></div>}
        </section>
      </div>

      <section class="shelf" aria-labelledby="shelf-title">
        <div class="shelf-heading"><h2 id="shelf-title">Or pick a book.</h2><a href="/">Browse the library <span aria-hidden="true">↗</span></a></div>
        <div class="shelf-books">
          {books.map((book, index) => (
            <button class="shelf-book" type="button" aria-pressed={book.id === featured?.id ? 'true' : 'false'} aria-label={`Preview ${book.title}`} data-book={JSON.stringify(book)} data-tone={tones[index % tones.length]}>
              <span class="small-cover" style={`--cover-tone: ${tones[index % tones.length]}`}>
                <span class="small-fallback"><span>LIBRARY</span><strong>{book.title}</strong><span>{book.authors[0]}</span></span>
                {book.cover_url && <img src={book.cover_url} alt="" width="58" height="86" />}
              </span>
              <span class="shelf-copy"><strong>{book.title}</strong><span>{book.authors.join(', ')}</span></span>
              <span class="selected-dot" aria-hidden="true"></span>
            </button>
          ))}
        </div>
      </section>
    </main>

    <script>
      const form = document.querySelector<HTMLFormElement>('#isbn-form');
      const input = document.querySelector<HTMLInputElement>('#desk-isbn');
      const normaliseISBN = (value: string) => {
        const isbn = value.replace(/[^\dXx]/g, '').toUpperCase();
        if (isbn.length !== 10) return isbn;
        const base = `978${isbn.slice(0, 9)}`;
        const sum = [...base].reduce((total, digit, index) => total + Number(digit) * (index % 2 ? 3 : 1), 0);
        return `${base}${(10 - sum % 10) % 10}`;
      };
      form?.addEventListener('submit', event => {
        if (!input?.value.trim()) return;
        event.preventDefault();
        const isbn = normaliseISBN(input.value);
        const books: {id: number; isbn: string}[] = JSON.parse(form.dataset.books || '[]');
        const match = books.find(book => normaliseISBN(book.isbn) === isbn);
        window.location.assign(match ? `/books/${match.id}/` : `/scan/?isbn=${encodeURIComponent(input.value.trim())}`);
      });
      document.querySelector('#lend-book')?.addEventListener('click', () => {
        const title = document.querySelector('#scan-title');
        const description = document.querySelector('#scan-description');
        const note = document.querySelector('#desk-note');
        if (title) title.textContent = 'Lend a book.';
        if (description) description.textContent = 'Scan the book you want to share.';
        if (note) note.textContent = 'Open the book, then choose a copy to lend.';
        input?.focus();
      });
      document.querySelectorAll<HTMLImageElement>('.hero-cover img, .small-cover img').forEach(image => {
        image.addEventListener('error', () => { image.hidden = true; });
      });
      document.querySelectorAll<HTMLButtonElement>('.shelf-book').forEach(button => {
        button.addEventListener('click', () => {
          const book: {id: number; title: string; authors: string[]; cover_url: string} = JSON.parse(button.dataset.book || '{}');
          document.querySelectorAll('.shelf-book').forEach(other => other.setAttribute('aria-pressed', String(other === button)));
          for (const selector of ['#hero-title', '#fallback-title']) {
            const element = document.querySelector(selector);
            if (element) element.textContent = book.title;
          }
          for (const selector of ['#hero-author', '#fallback-author']) {
            const element = document.querySelector(selector);
            if (element) element.textContent = book.authors.join(', ');
          }
          document.querySelectorAll<HTMLAnchorElement>('#hero-cover-link, #hero-open').forEach(link => { link.href = `/books/${book.id}/`; });
          document.querySelector('#hero-cover-link')?.setAttribute('aria-label', `Open ${book.title}`);
          document.querySelector<HTMLElement>('#hero-fallback')?.style.setProperty('--cover-tone', button.dataset.tone || '#d8b986');
          const image = document.querySelector<HTMLImageElement>('#hero-image');
          if (image) { image.hidden = !book.cover_url; if (book.cover_url) image.src = book.cover_url; else image.removeAttribute('src'); }
        });
      });
      if (window.matchMedia('(min-width: 760px) and (pointer: fine)').matches) input?.focus({preventScroll: true});
    </script>
  </body>
</html>

<style>
  :global(html) { background: #f5f2eb; color: #262c29; font-family: 'Desk Inter', sans-serif; -webkit-font-smoothing: antialiased; }
  :global(body) { margin: 0; }
  :global(*) { box-sizing: border-box; }
  :global(button), :global(input) { font: inherit; }
  :global(button), :global(a) { -webkit-tap-highlight-color: transparent; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(button) { color: inherit; }
  :global(button:focus-visible), :global(a:focus-visible) { outline: 3px solid #36604c; outline-offset: 5px; }
  :global([hidden]) { display: none !important; }
  .skip { position: absolute; left: 20px; top: -100px; z-index: 5; background: #fff; padding: 16px; }
  .skip:focus { top: 15px; }
  .app-header { min-height: 72px; display: flex; align-items: center; gap: 56px; margin: 0 42px; border-bottom: 1px solid #d8d6cc; }
  .wordmark { display: flex; gap: 10px; align-items: center; min-height: 44px; font-size: 27px; font-weight: 650; letter-spacing: -1.6px; }
  .wordmark svg { width: 24px; height: 26px; fill: #303b33; }
  .wordmark-dot { color: #638169; }
  nav { display: flex; gap: 8px; align-self: stretch; align-items: center; }
  nav a { min-height: 44px; display: flex; align-items: center; padding: 0 17px; font-size: 13px; color: #6d716a; gap: 12px; }
  nav a.current { color: #2d3d31; background: #e6e9df; border-radius: 5px; }
  nav a:hover, .preview:hover { color: #1f4b36; }
  .preview { margin-left: auto; display: flex; align-items: center; min-height: 44px; gap: 12px; color: #71766d; font-size: 11px; }
  main { margin: 0 auto; max-width: 1520px; padding: 24px 42px; }
  .desk-layout { display: grid; grid-template-columns: minmax(360px, .92fr) minmax(450px, 1.2fr); gap: 36px; }
  .scan-station { padding: 6px 0 0; min-width: 0; }
  .station-heading, .stage-heading { display: flex; align-items: center; justify-content: space-between; }
  .eyebrow { font-size: 10px; font-weight: 550; text-transform: uppercase; letter-spacing: 1.8px; margin: 0; }
  .station-mark { font-size: 9px; letter-spacing: 1px; color: #888a80; }
  .scan-intro { margin-top: 24px; }
  h1 { margin: 0; font: 440 clamp(42px, 4.7vw, 63px)/1.02 'Desk Newsreader', Georgia, serif; letter-spacing: -2px; }
  .scan-intro p { margin: 12px 0 0; font-size: 14px; color: #6f736a; }
  .scan-form { margin-top: 18px; padding: 13px 18px; border: 1px solid #d2d8c9; border-radius: 8px; background: #fdfcf7; }
  .scan-symbol { width: 100px; margin: 0 auto 7px; }
  .scan-symbol svg { display: block; width: 100%; }
  .corners { fill: none; stroke: #bac6b7; stroke-width: 2; }
  .bars { stroke: #495c4c; stroke-width: 3; }
  .scan-line { stroke: #c7ae78; stroke-width: 1.5; }
  .scan-form label { display: block; font-size: 11px; margin-bottom: 9px; color: #5b6258; }
  .input-row { display: flex; align-items: center; background: #fff; border: 1px solid #b8c3b2; border-radius: 5px; padding: 5px; }
  .input-row:focus-within { outline: 2px solid #54725a; outline-offset: 3px; }
  .input-row input { height: 48px; width: 100%; min-width: 0; background: none; border: 0; outline: none; padding: 0 11px; color: #253a2c; font-size: 16px; letter-spacing: -.3px; }
  .input-row input::placeholder { color: #969b90; }
  .input-row button { flex-shrink: 0; width: 48px; height: 48px; border: 0; border-radius: 3px; background: #34563f; color: #fff; cursor: pointer; }
  .input-row button:hover { background: #24432e; }
  .input-row button svg { width: 23px; height: 23px; stroke: currentColor; stroke-width: 1.5; }
  #isbn-help { font-size: 10px; color: #797d73; margin: 10px 0 0; }
  .desk-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 11px; margin-top: 20px; }
  .desk-action { min-height: 82px; display: flex; align-items: center; gap: 12px; background: transparent; border: 1px solid #d7d8cf; border-radius: 6px; text-align: left; padding: 14px 12px; cursor: pointer; }
  .desk-action:hover { background: #eaece2; border-color: #afbca9; }
  .desk-action > svg { flex-shrink: 0; width: 26px; height: 26px; stroke: #56654f; stroke-width: 1.3; }
  .desk-action strong { display: block; font-size: 12px; font-weight: 550; }
  .desk-action small { display: block; margin-top: 5px; color: #85887d; font-size: 9px; }
  .action-arrow { margin-left: auto; font-size: 15px; color: #737f6b; }
  .desk-note { color: #7c8075; font-size: 10px; margin: 14px 0 0; min-height: 14px; }
  .book-stage { position: relative; display: flex; flex-direction: column; min-width: 0; background: #eae7dc; padding: 25px 30px 16px; border-radius: 8px; overflow: hidden; }
  .stage-number { font-size: 9px; color: #828476; }
  .book-scene { position: relative; display: flex; align-items: center; justify-content: center; flex: 1; gap: 28px; padding: 25px 0 23px; }
  .book-scene::before { content: ''; width: 300px; height: 300px; position: absolute; top: 25px; left: -13px; border-radius: 50%; background: #e0d9c9; }
  .scene-line { position: absolute; bottom: 19px; left: -30px; right: -30px; height: 1px; background: #d1cec0; }
  .hero-cover { position: relative; width: 194px; height: 298px; flex-shrink: 0; border-radius: 2px 4px 4px 2px; box-shadow: 4px 8px 12px #3f392726, 16px 21px 29px #3f392715; transform: rotate(-4deg); isolation: isolate; }
  .hero-cover:after { position: absolute; content: ''; inset: 0; box-shadow: inset 0 0 0 1px #00000015; pointer-events: none; border-radius: inherit; }
  .hero-cover > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: fill; border-radius: inherit; }
  .book-spine { pointer-events: none; position: absolute; top: 0; left: 0; bottom: 0; width: 9px; background: linear-gradient(90deg, #0003, #fff1 45%, #0001 55%, transparent); }
  .cover-fallback { background: var(--cover-tone); height: 100%; color: #243225; padding: 22px 22px 23px; display: flex; align-items: flex-start; flex-direction: column; justify-content: space-between; border-radius: inherit; }
  .fallback-library { font-size: 7px; letter-spacing: 1.6px; }
  .cover-fallback strong { font: 450 27px/1.03 'Desk Newsreader', Georgia, serif; max-height: 185px; overflow: hidden; overflow-wrap: anywhere; }
  .fallback-rule { width: 32px; height: 1px; background: currentColor; }
  #fallback-author { font-size: 9px; line-height: 1.5; }
  .book-caption { position: relative; width: 172px; min-width: 0; padding-top: 35px; }
  .caption-label { font-size: 9px; color: #818575; margin: 0 0 12px; }
  .book-caption h3 { font: 450 clamp(25px, 2.8vw, 37px)/.98 'Desk Newsreader', Georgia, serif; letter-spacing: -.8px; margin: 0; text-wrap: balance; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  #hero-author { font-size: 11px; line-height: 1.6; color: #727769; margin: 13px 0; }
  .open-book { display: flex; align-items: center; justify-content: space-between; min-height: 44px; border-bottom: 1px solid #babfaf; font-size: 11px; gap: 18px; margin-top: 20px; }
  .open-book:hover { color: #29533a; border-color: #29533a; }
  .stage-footer { display: flex; align-items: center; justify-content: space-between; min-height: 30px; color: #7e8173; font-family: 'Desk Newsreader', Georgia, serif; font-size: 15px; font-style: italic; }
  .stage-footer svg { width: 25px; height: 25px; stroke: #838977; stroke-width: 1; }
  .empty-stage { display: grid; align-content: center; justify-content: center; flex: 1; }
  .empty-stage a { min-height: 44px; text-decoration: underline; }
  .shelf { margin-top: 20px; border-top: 1px solid #d8d6cc; padding-top: 12px; }
  .shelf-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 13px; }
  .shelf-heading h2 { font: 430 27px/1 'Desk Newsreader', Georgia, serif; letter-spacing: -.7px; margin: 0; }
  .shelf-heading > a { min-height: 44px; display: flex; align-items: center; gap: 20px; font-size: 10px; color: #646d5d; }
  .shelf-heading > a:hover { text-decoration: underline; }
  .shelf-books { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 11px; }
  .shelf-book { display: flex; position: relative; align-items: center; gap: 13px; text-align: left; border: 1px solid transparent; background: transparent; border-radius: 5px; padding: 10px; cursor: pointer; min-width: 0; }
  .shelf-book[aria-pressed='true'] { background: #e6e9de; border-color: #ced7c5; }
  .shelf-book:hover { background: #e9e9df; }
  .small-cover { position: relative; width: 52px; height: 79px; flex-shrink: 0; box-shadow: 2px 3px 4px #302f271c; }
  .small-cover:after { position: absolute; content: ''; inset: 0; box-shadow: inset 0 0 0 1px #00000012; pointer-events: none; }
  .small-cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: fill; }
  .small-fallback { display: flex; flex-direction: column; justify-content: space-between; padding: 7px 6px; height: 100%; background: var(--cover-tone); color: #293b30; }
  .small-fallback span { font-size: 3px; line-height: 1.3; letter-spacing: .4px; }
  .small-fallback strong { font: 450 11px/1 'Desk Newsreader', Georgia, serif; max-height: 44px; overflow: hidden; }
  .shelf-copy { min-width: 0; }
  .shelf-copy strong { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 11px; font-weight: 550; line-height: 1.45; }
  .shelf-copy > span { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: #818578; font-size: 9px; line-height: 1.5; margin-top: 7px; }
  .selected-dot { display: none; position: absolute; right: 7px; bottom: 7px; width: 4px; height: 4px; border-radius: 50%; background: #5a7754; }
  .shelf-book[aria-pressed='true'] .selected-dot { display: block; }
