#!/bin/sh
# Scan staged changes before committing; never print secret values.
set -eu
library_scanner=${GITLEAKS_BIN:-gitleaks}
if ! command -v "$library_scanner" >/dev/null 2>&1; then
  if [ -x bin/gitleaks ]; then
    library_scanner=./bin/gitleaks
  else
    echo 'Install Gitleaks or set GITLEAKS_BIN before committing. See SECURITY.md.' >&2
    exit 1
  fi
fi
exec "$library_scanner" git --pre-commit --staged --redact --no-banner
